# Copy to thermostat.env (git-ignored; deploy.sh still pushes it to the Pi) and fill in.
# compile.py loads it when it runs the program; a systemd unit would use EnvironmentFile=.

# NWS forecast grid: office/x,y from https://api.weather.gov/points/<lat>,<lon>
THERMOSTAT_NWS_GRIDPOINT=XXX/00,00
# contact for the NWS User-Agent (email or website); NWS asks for one
THERMOSTAT_NWS_CONTACT=you@example.com
